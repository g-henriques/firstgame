[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/upgrade_card.gd" id="1_card"]

[node name="UpgradeCard" type="Button"]
custom_minimum_size = Vector2(300, 46)
theme_type_variation = &"CardButton"
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Icon" type="TextureRect" parent="Margin/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 32)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Text" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Header" type="HBoxContainer" parent="Margin/HBox/Text"]
layout_mode = 2
mouse_filter = 2

[node name="Name" type="Label" parent="Margin/HBox/Text/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.996078, 0.905882, 0.380392, 1)
text = "1. Magic Wand"

[node name="Level" type="Label" parent="Margin/HBox/Text/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.172549, 0.909804, 0.960784, 1)
text = "NEW!"

[node name="Desc" type="Label" parent="Margin/HBox/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Fires a magic bolt at the nearest enemy."
autowrap_mode = 3

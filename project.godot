; Engine configuration file.
; Arena Survivor - Godot 4.3

config_version=5

[application]

config/name="Arena Survivor"
config/description="A Vampire Survivors inspired arena survival game."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.0941176, 0.0784314, 0.145098, 1)
config/icon="res://assets/icon.png"

[autoload]

Assets="*res://scripts/autoload/assets.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[gui]

theme/custom="res://assets/ui/theme.tres"

